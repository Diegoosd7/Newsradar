# Database
DATABASE_URL=sqlite:////app/data/news.db

# Application
DISABLE_SCHEDULER=0
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:80

# AI (required for alert summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Email (optional – notifications won't send if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# SonarQube (optional – for code quality analysis)
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=your_sonarqube_token_here
# Generate token at: http://localhost:9000 → My Account → Security
